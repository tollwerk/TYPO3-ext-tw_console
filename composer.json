{
    "name": "tollwerk/tw-console",
    "type": "typo3-cms-extension",
    "description": "Collection of useful ViewHelpers",
    "license": "LGPL-3.0-or-later",
    "keywords": [
        "typo3"
    ],
    "authors": [
        {
            "name": "Klaus Fiedler",
            "role": "Developer",
            "email": "klaus@tollwerk.de",
            "homepage": "https://tollwerk.de"
        }
    ],
    "homepage": "https://github.com/tollwerk/TYPO3-ext-tw_console",
    "support": {
        "issues": "https://github.com/tollwerk/TYPO3-ext-tw_console/issues"
    },
    "require": {
        "typo3/cms-core": "^13 || ^14"
    },
    "autoload": {
        "psr-4": {
            "Tollwerk\\TwConsole\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "tw_console"
        },
        "branch-alias": {
            "dev-master": "13.0.x-dev"
        }
    }
}
